    "bg": "nebula",
    "chars": [
     {
      "id": "star",
      "mood": "happy"
     },
     {
      "id": "cosmo",
      "mood": "happy"
     }
    ]
   },
   "choices": [
    {
     "text": "Amarelo como o Sol",
     "next": "end_yellow",
     "tags": [
      "imagination"
     ],
     "icon": "sun"
    },
    {
     "text": "Azul como Netuno",
     "next": "end_blue",
     "tags": [
      "imagination"
     ],
     "icon": "planet"
    },
