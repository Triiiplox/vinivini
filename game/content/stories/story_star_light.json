 "nodes": {
  "s1": {
   "text": "Lá no céu, uma estrelinha chamada Lumi não conseguia brilhar.",
   "scene": {
    "bg": "space",
    "chars": [
     {
      "id": "star",
      "mood": "sad"
     }
    ]
   },
   "choices": [
    {
     "text": "Contar uma piada para ela",
     "next": "s2",
     "tags": [
      "joy"
     ],
     "icon": "smile"
    },
    {
     "text": "Perguntar como ela se sente",
     "next": "s3",
     "tags": [
      "empathy"
     ],
     "icon": "heart"
    }
   ]
  },
  "s2": {
   "text": "Lumi deu uma risadinha! Uma faísca de luz apareceu.",
   "scene": {
    "bg": "space",
    "chars": [
     {
      "id": "star",
      "mood": "happy"
     },
     {
      "id": "avatar",
      "mood": "happy"
     }
    ]
   },
   "next": "s4"
  },
  "s3": {
   "text": "— Estou triste porque acho que não sou especial — disse Lumi. Todo mundo é especial do seu jeito!",
   "scene": {
    "bg": "space",
    "chars": [
     {
      "id": "star",
      "mood": "sad"
     },
     {
      "id": "avatar",
      "mood": "calm"
     }
    ]
   },
   "choices": [
    {
     "text": "Cantar uma música juntos",
     "next": "s4",
     "tags": [
      "joy"
     ],
     "icon": "music"
    },
    {
     "text": "Dançar entre os planetas",
     "next": "s5",
     "tags": [
      "imagination"
     ],
     "icon": "planet"
    }
   ]
  },
  "s4": {
   "text": "Vocês cantam: brilha, brilha, estrelinha! A luz de Lumi cresce!",
