{
 "id": "story_star_light_001",
 "title": "A Saudade da Astronauta",
 "cover": "space",
 "start": "s1",
 "reward_stars": 3,
 "nodes": {
  "s1": {
   "text": "Na estação espacial, a astronauta Ana está quietinha. Faz muitos dias que ela não vê a família.",
   "scene": {
    "bg": "ship",
    "chars": [
     {
      "id": "crew",
      "mood": "sad"
     }
    ]
   },
   "choices": [
    {
     "text": "Perguntar como ela se sente",
     "next": "s3",
     "tags": [
      "empathy"
     ],
     "icon": "heart"
    },
    {
     "text": "Contar uma piada para ela",
     "next": "s2",
     "tags": [
      "joy"
     ],
     "icon": "smile"
    }
   ]
  },
  "s2": {
   "text": "Ana deu uma risadinha. Mas depois disse: — Estou com saudade de casa.",
   "scene": {
    "bg": "ship",
    "chars": [
     {
      "id": "crew",
      "mood": "happy"
     },
     {
      "id": "avatar",
      "mood": "happy"
     }
    ]
   },
   "next": "s3"
  },
  "s3": {
   "text": "— Estou com saudade da minha família — disse Ana. Sentir saudade é normal. Como podemos ajudar?",
   "scene": {
    "bg": "ship",
    "chars": [
     {
      "id": "crew",
      "mood": "sad"
     },
     {
      "id": "avatar",
      "mood": "calm"
     }
    ]
   },
   "choices": [
    {
     "text": "Ligar para a família por vídeo",
     "next": "s4",
     "tags": [
      "empathy"
     ],
     "icon": "heart"
    },
    {
     "text": "Olhar a Terra pela janela",
     "next": "s5",
     "tags": [
      "curiosity"
     ],
     "icon": "planet"
    }
   ]
  },
  "s4": {
   "text": "Na tela aparecem os filhos da Ana dando tchau! Ela sorri e manda um beijo.",
   "scene": {
    "bg": "ship",
    "chars": [
     {
      "id": "crew",
      "mood": "happy"
     },
     {
      "id": "avatar",
      "mood": "happy"
     }
    ]
   },
   "next": "s6"
  },
  "s5": {
   "text": "Pela janela, a Terra azul gira devagarinho. — Lá embaixo está a minha casa! — diz Ana, sorrindo.",
   "scene": {
    "bg": "space",
    "chars": [
     {
      "id": "crew",
      "mood": "happy"
     },
     {
      "id": "avatar",
      "mood": "happy"
     }
    ]
   },
   "next": "s6"
  },
  "s6": {
   "text": "Ana quer mandar um presente para a família. O que ela manda?",
   "scene": {
    "bg": "ship",
    "chars": [
     {
      "id": "crew",
      "mood": "happy"
     },
     {
      "id": "cosmo",
      "mood": "happy"
     }
    ]
   },
   "choices": [
    {
     "text": "Uma foto da Terra vista do espaço",
     "next": "end_photo",
     "tags": [
      "imagination"
     ],
     "icon": "planet"
    },
    {
     "text": "Um desenho da estação",
     "next": "end_draw",
     "tags": [
      "imagination"
     ],
     "icon": "palette"
    },
    {
     "text": "Uma música cantada juntos",
     "next": "end_song",
     "tags": [
      "joy"
     ],
     "icon": "music"
    }
   ]
  },
  "end_photo": {
   "text": "A família recebe a foto da Terra e todo mundo fica feliz. Obrigada pela ajuda, comandante!",
   "scene": {
    "bg": "space",
    "chars": [
     {
      "id": "crew",
      "mood": "happy"
     },
     {
      "id": "avatar",
      "mood": "happy"
     }
    ]
   },
   "end": true
  },
  "end_draw": {
   "text": "Vocês desenham a estação juntos e mandam para a família. Que lindo! Obrigada, comandante!",
   "scene": {
    "bg": "ship",
    "chars": [
     {
      "id": "crew",
      "mood": "happy"
     },
     {
      "id": "avatar",
      "mood": "happy"
     }
    ]
   },
   "end": true
