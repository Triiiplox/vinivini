    "bg": "space",
    "chars": [
     {
      "id": "star",
      "mood": "happy"
     },
     {
      "id": "avatar",
      "mood": "happy"
     }
    ]
   },
   "next": "s6"
  },
  "s5": {
   "text": "Vocês dançam no espaço, girando como planetas! Lumi fica cada vez mais brilhante.",
