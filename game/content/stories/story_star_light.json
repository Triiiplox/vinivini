    "bg": "nebula",
    "chars": [
     {
      "id": "star",
      "mood": "happy"
     },
     {
      "id": "avatar",
      "mood": "happy"
     }
    ]
   },
   "next": "s6"
  },
  "s6": {
   "text": "Lumi quer escolher a cor do seu novo brilho. Qual cor?",
