    "bg": "mars",
    "chars": [
     {
      "id": "robot",
      "mood": "sad"
     },
     {
      "id": "avatar",
      "mood": "calm"
     }
    ]
   },
   "next": "n4"
  },
  "n3": {
   "text": "O Cosmo chegou voando: — Vamos ajudar juntos! O robozinho contou que perdeu o amigo Bip.",
   "scene": {
    "bg": "mars",
    "chars": [
     {
      "id": "robot",
      "mood": "sad"
     },
     {
      "id": "cosmo",
      "mood": "happy"
     }
    ]
   },
   "next": "n4"
  },
  "n4": {
   "text": "Onde vamos procurar o Bip?",
