 "nodes": {
  "n1": {
   "text": "Em Marte, um robozinho está sozinho. Ele parece triste.",
   "scene": {
    "bg": "mars",
    "chars": [
     {
      "id": "robot",
      "mood": "sad"
     }
    ]
   },
   "choices": [
    {
     "text": "Perguntar o que aconteceu",
     "next": "n2",
     "tags": [
      "empathy"
     ],
     "icon": "heart"
    },
    {
     "text": "Chamar o Cosmo para ajudar",
     "next": "n3",
     "tags": [
      "cooperation"
     ],
     "icon": "cosmo"
    }
   ]
  },
  "n2": {
   "text": "— Eu perdi meu amigo, o cachorrinho-robô Bip! — disse o robozinho.",
